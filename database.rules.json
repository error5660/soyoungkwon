{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && data.child('meta/host').val() === auth.uid",
        "meta": {
          ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "events": {
          "$to": {
            ".write": "auth != null && auth.uid === $to",
            "$id": {
              ".write": "auth != null && (auth.uid === $to || (!data.exists() && newData.child('from').val() === auth.uid))"
            }
          }
        }
      }
    },
    "lobby": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && (data.exists() ? data.child('host').val() === auth.uid : newData.child('host').val() === auth.uid)"
      }
    },
    "ranks": {
      ".read": "auth != null",
      ".indexOn": ["g", "d"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "g": { ".validate": "newData.isNumber() && (root.child('users/' + $uid + '/gold').exists() ? newData.val() === root.child('users/' + $uid + '/gold').val() : newData.val() === 0)" },
        "d": { ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 5000" },
        "$other": { ".validate": false }
      }
    },
    "mm": {
      "$map": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !newData.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.child('uid').val() === auth.uid"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "gold": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 30"
        },
        "skill": {
          "name": { ".validate": "data.val() === newData.val()" },
          "img": { ".validate": "data.val() === newData.val()" },
          "$other": { ".validate": false }
        },
        "skills": {
          "$id": {
            ".validate": "$id === 's1' || $id === 's2'",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 10 && (data.val() === newData.val() || newData.parent().parent().parent().child('gold').val() === data.parent().parent().parent().child('gold').val() - 500)"
            },
            "img": {
              ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length < 200000 && (data.val() === newData.val() || newData.parent().parent().parent().child('gold').val() === data.parent().parent().parent().child('gold').val() - 500)"
            },
            "$other": { ".validate": false }
          }
        },
        "items": {
          "$id": {
            ".validate": "newData.val() === true && (data.exists() || newData.parent().parent().child('gold').val() <= data.parent().parent().child('gold').val() - ($id === 'ko' ? 300 : ($id.beginsWith('h_') ? 150 : 100)))"
          }
        },
        "koText": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12 && newData.parent().child('items').child('ko').val() === true"
        },
        "skins": {
          "$id": {
            ".validate": "newData.val() === true && (data.exists() || newData.parent().parent().child('gold').val() <= data.parent().parent().child('gold').val() - 200)"
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
